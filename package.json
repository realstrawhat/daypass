{
  "name": "daypass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "test": "node --env-file-if-exists=.env.local --test tests/booking-rules.test.mjs tests/hours.test.mjs",
    "test:ui": "node --env-file-if-exists=.env.local --test tests/journey.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "latest",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "maplibre-gl": "5.24.0",
    "next": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "puppeteer-core": "^25.16.0",
    "typescript": "latest"
  }
}
